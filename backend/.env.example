# Backend environment variables template
# Copy to .env and fill in actual values

APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://smartgaz:smartgaz_pass@localhost:5432/smartgaz
DATABASE_URL_SYNC=postgresql://smartgaz:smartgaz_pass@localhost:5432/smartgaz

# For local dev without Postgres: use SQLite
# DATABASE_URL=sqlite+aiosqlite:///./smartgaz.db
# DATABASE_URL_SYNC=sqlite:///./smartgaz.db

# JWT / Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60*24

# Bot
BOT_TOKEN=your-telegram-bot-token

# SMS
SMS_PROVIDER=eskiz
SMS_API_KEY=

# Settings defaults
DEFAULT_COOLDOWN_DAYS=20
DEFAULT_PRICE_PER_KG=2800
DEFAULT_GPS_INTERVAL_SEC=30
